{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ignorePaths": [],
  "timezone": "Asia/Tokyo",
  "schedule": [
    "before 9am on monday"
  ],
  "automerge": false,
  "automergeStrategy": "merge-commit",
  "separateMajorMinor": false,
  "labels": [
    "dependencies"
  ],
  "assignees": [
    "kakikubo"
  ],
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 9am on monday"
    ],
    "automerge": true,
    "platformAutomerge": true,
    "minimumReleaseAge": null
  },
  "packageRules": [
    {
      "description": "パッチ・マイナー更新は原則まとめて週1回（手動レビュー）。以降のルールで上書きする",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "non-major dependencies",
      "groupSlug": "non-major"
    },
    {
      "description": "ツール類のパッチ・マイナーは別グループにまとめて自動マージ",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "safe non-major dependencies",
      "groupSlug": "safe-non-major",
      "automerge": true,
      "platformAutomerge": true,
      "matchPackageNames": [
        "/^rubocop/",
        "/^rspec/",
        "/^simplecov/",
        "/^sass/",
        "css-loader",
        "mini-css-extract-plugin",
        "/^webpack/",
        "@playwright/test",
        "bootsnap",
        "nokogiri",
        "bcrypt",
        "erb_lint",
        "factory_bot_rails",
        "actions/checkout",
        "actions/cache",
        "actions/setup-node",
        "pnpm/action-setup",
        "ruby/setup-ruby",
        "release-drafter/release-drafter"
      ]
    },
    {
      "description": "pnpm と Node.js はリリースが多いので月1回、まとめて自動マージ",
      "matchPackageNames": [
        "pnpm",
        "node"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "pnpm and node",
      "groupSlug": "pnpm-node",
      "schedule": [
        "before 9am on the first day of the month"
      ],
      "automerge": true,
      "platformAutomerge": true
    }
  ]
}
